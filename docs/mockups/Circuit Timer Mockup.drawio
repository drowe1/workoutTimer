  <diagram name="Circuit Running" id="rJ8GDhzs7Uq5kCis8FYR">
    <mxGraphModel dx="1975" dy="849" grid="0" gridSize="10" guides="1" tooltips="1" connect="0" arrows="0" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
