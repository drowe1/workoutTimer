        <mxCell id="3EOnVQmZOxO2PskyNB4L-4" parent="3EOnVQmZOxO2PskyNB4L-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=#FFFFFF;fontSize=36;" value="Workout Timer" vertex="1">
